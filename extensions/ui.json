{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/ui.schema.json",
  "configuration_contract": {
    "optional_files": [
      "scenario.json",
      "config/overwrite.json",
      "payloads/prompts/",
      "knowledge/"
    ],
    "required_files": [
      "manifest.json",
      "README.md",
      "SPEC.md",
      "config/default.json",
      "payloads/",
      "LICENSE.md",
      "TERM.md"
    ]
  },
  "observability_dashboard": {
    "panels": [
      "current_status",
      "recent_events",
      "pending_human_requests",
      "output_artifacts",
      "resource_usage",
      "errors",
      "input_lag",
      "backpressure",
      "llm_calls",
      "token_budget",
      "llm_retries",
      "output_skill_attempts",
      "output_skill_failures"
    ],
    "reads": [
      "events.jsonl",
      "human.jsonl",
      "logs.jsonl",
      "resources.jsonl",
      "result.json",
      "final_artifact.json",
      "cctv_report.json",
      "cctv_report.md",
      "web_ui.json"
    ],
    "schema_version": "mn.blueprint.observability_dashboard.v1",
    "source": "local_run_store"
  },
  "init_config_review": {
    "required": true,
    "instruction": "Choose up to four cameras and enter their stream URLs securely.",
    "fields": [
      {
        "path": "video_source.count",
        "label": "Camera count",
        "type": "text",
        "value_type": "number",
        "role": "input",
        "default": 1,
        "required": false,
        "choices": [
          {
            "value": 1,
            "label": "1 camera"
          },
          {
            "value": 2,
            "label": "2 cameras"
          },
          {
            "value": 3,
            "label": "3 cameras"
          },
          {
            "value": 4,
            "label": "4 cameras"
          }
        ]
      },
      {
        "path": "video_source.uri",
        "label": "Video stream URL",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container."
      },
      {
        "path": "video_source.camera_2.uri",
        "label": "Video stream URL (camera 2)",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container.",
        "active_when_any": [
          {
            "key": "video_source.count",
            "equals": 2
          },
          {
            "key": "video_source.count",
            "equals": 3
          },
          {
            "key": "video_source.count",
            "equals": 4
          }
        ]
      },
      {
        "path": "video_source.camera_3.uri",
        "label": "Video stream URL (camera 3)",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container.",
        "active_when_any": [
          {
            "key": "video_source.count",
            "equals": 3
          },
          {
            "key": "video_source.count",
            "equals": 4
          }
        ]
      },
      {
        "path": "video_source.camera_4.uri",
        "label": "Video stream URL (camera 4)",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container.",
        "active_when_any": [
          {
            "key": "video_source.count",
            "equals": 4
          }
        ]
      },
      {
        "path": "video_source.name",
        "label": "First camera name",
        "type": "text",
        "default": "Camera 1",
        "required": false
      },
      {
        "path": "inputs.payload.monitoring_goal",
        "label": "Monitoring goals",
        "type": "textarea",
        "required": false,
        "description": "Enter up to five visible conditions, one per line. For example, people without safety helmets. Leave blank for general activity."
      },
      {
        "path": "outputs.folder_path",
        "label": "Output folder",
        "type": "local_path",
        "path_kind": "directory",
        "default": "~/Downloads/cctv-operator",
        "required": false
      }
    ]
  },
  "web_ui": {
    "enabled": true,
    "kind": "service",
    "adapter": "external-url",
    "node_id": "camera_operator",
    "service_name": "cctv-operator-web-ui",
    "description": "Read-only live previews and completed NVIDIA observations for the configured cameras.",
    "reads": [
      "monitoring_state.json",
      "cctv_report.json"
    ],
    "registration": {
      "module": "domain.service_lifecycle",
      "package": "mn-python-sdk-web-ui"
    }
  },
  "starter_questions": [
    "What have the cameras observed?",
    "Did anyone wear a red coat in the past hour?",
    "Which cameras can you monitor?",
    "Explain the latest observation’s limits."
  ],
  "setup_guide": {
    "schema": "otterdesk.setup_guide.v1",
    "introduction": "I monitor up to four cameras and save observations with their capture times. Start by choosing how many cameras to monitor.",
    "prompt_file": "@/payloads/prompts/setup.md",
    "sample": {
      "available": false
    },
    "real": {
      "introduction": "Choose how many cameras to monitor, then enter each approved RTSP or RTSPS URL in its secure field.",
      "values": {}
    },
    "fields": [
      {
        "path": "video_source.count",
        "label": "Camera count",
        "type": "text",
        "value_type": "number",
        "role": "input",
        "default": 1,
        "required": false,
        "choices": [
          {
            "value": 1,
            "label": "1 camera"
          },
          {
            "value": 2,
            "label": "2 cameras"
          },
          {
            "value": 3,
            "label": "3 cameras"
          },
          {
            "value": 4,
            "label": "4 cameras"
          }
        ]
      },
      {
        "path": "video_source.uri",
        "label": "Video stream URL",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container."
      },
      {
        "path": "video_source.camera_2.uri",
        "label": "Video stream URL (camera 2)",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container.",
        "active_when_any": [
          {
            "key": "video_source.count",
            "equals": 2
          },
          {
            "key": "video_source.count",
            "equals": 3
          },
          {
            "key": "video_source.count",
            "equals": 4
          }
        ]
      },
      {
        "path": "video_source.camera_3.uri",
        "label": "Video stream URL (camera 3)",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container.",
        "active_when_any": [
          {
            "key": "video_source.count",
            "equals": 3
          },
          {
            "key": "video_source.count",
            "equals": 4
          }
        ]
      },
      {
        "path": "video_source.camera_4.uri",
        "label": "Video stream URL (camera 4)",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS URL reachable from the NVIDIA computer and its video analysis container.",
        "active_when_any": [
          {
            "key": "video_source.count",
            "equals": 4
          }
        ]
      },
      {
        "path": "video_source.name",
        "label": "First camera name",
        "type": "text",
        "default": "Camera 1",
        "required": false
      },
      {
        "path": "inputs.payload.monitoring_goal",
        "label": "Monitoring goals",
        "type": "textarea",
        "required": false,
        "description": "Enter up to five visible conditions, one per line. For example, people without safety helmets. Leave blank for general activity."
      },
      {
        "path": "outputs.folder_path",
        "label": "Output folder",
        "type": "local_path",
        "path_kind": "directory",
        "default": "~/Downloads/cctv-operator",
        "required": false
      }
    ]
  }
}
